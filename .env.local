# Local development environment variables for gramsrv

# Copy this file to .env or load variables from it in your shell before running the server.
# Replace the placeholder values with your server's public IP, ports, and database/redis credentials.

# MTProto listen address (bind on your host)
TELESRV_LISTEN=0.0.0.0:2398

# Publicly reachable IP or domain advertised to clients
TELESRV_ADVERTISE_IP=YOUR.PUBLIC.IP.OR.HOSTNAME

# Self-hosted DC id (keep numeric)
TELESRV_DC=2

# Development fixed login code (secure this in production)
TELESRV_DEV_AUTH_CODE=12345

# Postgres connection string example (replace user/pass/db)
TELESRV_POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5432/gramsrv?sslmode=disable

# Redis address
TELESRV_REDIS_ADDR=127.0.0.1:6399

# Optional public link landing page local bind (keep on loopback for production)
TELESRV_PUBLIC_LINK_WEB_ADDR=127.0.0.1:2401

# External canonical base URL shown in generated links
TELESRV_PUBLIC_BASE_URL=https://your-domain.example
TELESRV_PUBLIC_WEB_BASE_URL=https://web.your-domain.example
TELESRV_PUBLIC_APP_NAME=YourApp
TELESRV_PUBLIC_APP_SCHEME=yourapp

# Bot API example address (optional)
TELESRV_BOT_API_ADDR=

# AI / Translation defaults (enable/disable as needed)
TELESRV_AI_ENABLED=true
TELESRV_AI_PROVIDERS=local
TELESRV_TRANSLATION_ENABLED=true

# Notes:
# - Replace YOUR.PUBLIC.IP.OR.HOSTNAME with the public IP or domain name of your server
# - Adjust ports if you need different MTProto/listen ports
# - Keep TELESRV_PUBLIC_LINK_WEB_ADDR on loopback and reverse-proxy externally using HTTPS in production
